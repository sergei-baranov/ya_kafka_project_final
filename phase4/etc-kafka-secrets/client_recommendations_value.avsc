{
  "type": "record",
  "name": "ClientRecommendations",
  "namespace": "com.shop.api",
  "fields": [
    { "name": "client", "type": "int" },
    { "name": "generated_at", "type": "string" },
    {
      "name": "top_words",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "WordCount",
          "fields": [
            { "name": "word", "type": "string" },
            { "name": "count", "type": "long" }
          ]
        }
      }
    }
  ]
}
